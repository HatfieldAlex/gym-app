// Gym app schema — design source of truth.
// Render: paste into https://dbdiagram.io  (or `npx @dbml/cli dbml2sql schema.dbml --postgres`)

Project gym_app {
  database_type: 'PostgreSQL'
  Note: 'Workout tracking. Nothing here is implemented yet — this file is the design.'
}

Table user {
  id    uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
}

// One user has many training sessions.
Table training_session {
  id            uuid [pk, default: `gen_random_uuid()`]
  user_id       uuid [not null, ref: > user.id]
  type          session_type [not null]
  created_at    timestamptz  [not null, default: `now()`]

  indexes {
    (user_id, created_at)
  }
}

// The exercise catalogue: one row per movement, referenced by performed_exercise.
Table exercise {
  id             uuid [pk, default: `gen_random_uuid()`]
  name           varchar(120) [not null, unique]
  modality       modality     [not null]
  primary_muscle muscle_group [not null]
  created_at     timestamptz  [not null, default: `now()`]
}

// One movement as actually performed in one session.
// Many per training_session; many can reference the same exercise.
Table performed_exercise {
  id                  uuid [pk, default: `gen_random_uuid()`]
  training_session_id uuid [not null, ref: > training_session.id]
  exercise_id         uuid [not null, ref: > exercise.id]
  position            int  [not null, note: 'ordinal within the session']
  created_at          timestamptz [not null, default: `now()`]

  indexes {
    (training_session_id, position) [unique]
    (exercise_id)
  }
}

// One set of one performed_exercise. Many sets per performed_exercise.
Table performed_set {
  id                    uuid [pk, default: `gen_random_uuid()`]
  performed_exercise_id uuid [not null, ref: > performed_exercise.id]
  set_index             int  [not null, note: 'ordinal within the performed_exercise']
  weight_kg             decimal(6,2) [null, note: 'always stored metric; convert at display time']
  reps                  int [null]
  distance_m            decimal(9,2) [null, note: 'always stored metric; convert at display time']
  duration_s            int [null, note: 'for time-based work instead of reps']
  rpe                   decimal(3,1) [null]
  is_warmup             boolean [not null, default: false]

  indexes {
    (performed_exercise_id, set_index) [unique]
  }
}

// One rep of one performed_set. Many reps per performed_set.
Table performed_rep {
  id               uuid [pk, default: `gen_random_uuid()`]
  performed_set_id uuid [not null, ref: > performed_set.id]
  rep_index        int  [not null, note: 'ordinal within the performed_set']

  indexes {
    (performed_set_id, rep_index) [unique]
  }
}

Enum unit_system {
  metric
  imperial
}

Enum session_type {
  strength
  cardio
  mobility
  mixed
}

Enum modality {
  barbell
  dumbbell
  machine
  bodyweight
  cardio
}

Enum muscle_group {
  chest
  back
  shoulders
  quads
  hamstrings
  glutes
  arms
  core
  full_body
}
