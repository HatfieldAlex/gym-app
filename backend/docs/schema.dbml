// Gym app database schema.
// GENERATED FROM THE DJANGO MODELS — do not hand-edit; regenerate instead.
// Source: the Django app registry (model._meta), via manage.py export_dbml.
// Render: paste into https://dbdiagram.io

Project gym_app {
  database_type: 'PostgreSQL'
  Note: '''
Workout tracking. Every table, column, type, index and relationship below is
read directly off the Django models, so this file mirrors them exactly.
Column types are the SQL Django emits on PostgreSQL; the development database
is SQLite (settings.DATABASES['default'] = django.db.backends.sqlite3),
whose affinities are looser but structurally identical.
Django-level delete behaviour (on_delete=...) is recorded as a column note,
since DBML has no way to express it.
'''
}

// ==========================================================================
// app: catalog  (project)
// ==========================================================================

Table catalog_exercisedefinition {
  id            uuid         [pk, note: 'default set in Python: uuid.uuid4()']
  name          varchar(120) [not null, unique]
  created_by_id integer      [null, ref: > auth_user.id, note: 'on_delete=SET_NULL; who first added this movement; null for the seeded and admin-created rows']
  created_at    timestamptz  [not null, note: 'set to now() on insert (auto_now_add)']

  indexes {
    created_by_id [note: 'implicit: Django indexes every ForeignKey column']
  }

  Note: 'The exercise catalogue: one row per movement, referenced by PerformedExercise.'
}

// ==========================================================================
// app: observations  (project)
// ==========================================================================

Table observations_performedexercise {
  id                       uuid        [pk, note: 'default set in Python: uuid.uuid4()']
  training_session_id      uuid        [not null, ref: > observations_trainingsession.id, note: 'on_delete=CASCADE']
  exercise_definition_id   uuid        [not null, ref: > catalog_exercisedefinition.id, note: 'on_delete=PROTECT']
  exercise_prescription_id uuid        [null, ref: > protocols_exerciseprescription.id, note: 'on_delete=SET_NULL']
  created_at               timestamptz [not null, note: 'set to now() on insert (auto_now_add)']

  indexes {
    training_session_id [note: 'implicit: Django indexes every ForeignKey column']
    exercise_definition_id [note: 'implicit: Django indexes every ForeignKey column']
    exercise_prescription_id [note: 'implicit: Django indexes every ForeignKey column']
    (training_session_id, created_at) [name: 'perfex_session_created_idx']
  }

  Note: 'One movement as actually performed in one session. Many per TrainingSession; many can reference the same ExerciseDefinition.'
}

Table observations_performedrep {
  id               uuid    [pk, note: 'default set in Python: uuid.uuid4()']
  performed_set_id uuid    [not null, ref: > observations_performedset.id, note: 'on_delete=CASCADE']
  rep_index        integer [not null]

  indexes {
    performed_set_id [note: 'implicit: Django indexes every ForeignKey column']
    (performed_set_id, rep_index) [unique, name: 'perfrep_set_rep_index_uniq']
  }

  Note: 'One rep of one PerformedSet. Many reps per PerformedSet.'
}

Table observations_performedset {
  id                    uuid         [pk, note: 'default set in Python: uuid.uuid4()']
  performed_exercise_id uuid         [not null, ref: > observations_performedexercise.id, note: 'on_delete=CASCADE']
  weight_kg             numeric(6,2) [null]
  reps                  integer      [null]
  distance_m            numeric(9,2) [null]
  duration_s            integer      [null]
  rpe                   numeric(3,1) [null]
  created_at            timestamptz  [not null, note: 'set to now() on insert (auto_now_add)']

  indexes {
    performed_exercise_id [note: 'implicit: Django indexes every ForeignKey column']
    (performed_exercise_id, created_at) [name: 'perfset_exercise_created_idx']
  }

  Note: 'One set of one PerformedExercise. Many sets per PerformedExercise.'
}

Table observations_trainingsession {
  id         uuid        [pk, note: 'default set in Python: uuid.uuid4()']
  user_id    integer     [not null, ref: > auth_user.id, note: 'on_delete=CASCADE']
  type       varchar(8)  [not null, default: 'mixed']
  created_at timestamptz [not null, note: 'set to now() on insert (auto_now_add)']
  started_at timestamptz [not null, note: 'default set in Python: django.utils.timezone.now(); when the training actually happened; created_at is when the row was written']
  ended_at   timestamptz [null, note: 'null while the session is in progress']

  indexes {
    user_id [note: 'implicit: Django indexes every ForeignKey column']
    (user_id, started_at) [name: 'trainsess_user_started_idx']
  }

  Note: 'One user has many training sessions. CHECK trainsess_ended_after_started: (ended_at IS NULL OR ended_at >= started_at)'
}

// ==========================================================================
// app: protocols  (project)
// ==========================================================================

Table protocols_exerciseprescription {
  id uuid [pk, note: 'default set in Python: uuid.uuid4()']

  Note: 'One prescription, referenced by many PerformedExercise rows. The DBML declares this table with an `id` column and nothing else, so this model is a bare primary key. Left as-is rather than inventing columns.'
}

// ==========================================================================
// app: admin
// ==========================================================================

Table django_admin_log {
  id              integer      [pk]
  action_time     timestamptz  [not null, note: 'default set in Python: django.utils.timezone.now()']
  user_id         integer      [not null, ref: > auth_user.id, note: 'on_delete=CASCADE']
  content_type_id integer      [null, ref: > django_content_type.id, note: 'on_delete=SET_NULL']
  object_id       text         [null]
  object_repr     varchar(200) [not null]
  action_flag     smallint     [not null, note: 'choices: 1, 2, 3']
  change_message  text         [not null]

  indexes {
    user_id [note: 'implicit: Django indexes every ForeignKey column']
    content_type_id [note: 'implicit: Django indexes every ForeignKey column']
  }
}

// ==========================================================================
// app: auth
// ==========================================================================

Table auth_group {
  id   integer      [pk]
  name varchar(150) [not null, unique]

  Note: 'Groups are a generic way of categorizing users to apply permissions, or some other label, to those users.'
}

Table auth_group_permissions {
  id            integer [pk]
  group_id      integer [not null, ref: > auth_group.id, note: 'on_delete=CASCADE']
  permission_id integer [not null, ref: > auth_permission.id, note: 'on_delete=CASCADE']

  indexes {
    group_id [note: 'implicit: Django indexes every ForeignKey column']
    permission_id [note: 'implicit: Django indexes every ForeignKey column']
    (group_id, permission_id) [unique]
  }
}

Table auth_permission {
  id              integer      [pk]
  name            varchar(255) [not null]
  content_type_id integer      [not null, ref: > django_content_type.id, note: 'on_delete=CASCADE']
  codename        varchar(100) [not null]

  indexes {
    content_type_id [note: 'implicit: Django indexes every ForeignKey column']
    (content_type_id, codename) [unique]
  }

  Note: 'The permissions system provides a way to assign permissions to specific users and groups of users.'
}

Table auth_user {
  id           integer      [pk]
  password     varchar(128) [not null]
  last_login   timestamptz  [null]
  is_superuser boolean      [not null, default: `false`, note: 'Designates that this user has all permissions without explicitly assigning them.']
  username     varchar(150) [not null, unique, note: 'Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.']
  first_name   varchar(150) [not null]
  last_name    varchar(150) [not null]
  email        varchar(254) [not null]
  is_staff     boolean      [not null, default: `false`, note: 'Designates whether the user can log into this admin site.']
  is_active    boolean      [not null, default: `true`, note: 'Designates whether this user should be treated as active. Unselect this instead of deleting accounts.']
  date_joined  timestamptz  [not null, note: 'default set in Python: django.utils.timezone.now()']

  Note: 'Users within the Django authentication system are represented by this model.'
}

Table auth_user_groups {
  id       integer [pk]
  user_id  integer [not null, ref: > auth_user.id, note: 'on_delete=CASCADE']
  group_id integer [not null, ref: > auth_group.id, note: 'on_delete=CASCADE']

  indexes {
    user_id [note: 'implicit: Django indexes every ForeignKey column']
    group_id [note: 'implicit: Django indexes every ForeignKey column']
    (user_id, group_id) [unique]
  }
}

Table auth_user_user_permissions {
  id            integer [pk]
  user_id       integer [not null, ref: > auth_user.id, note: 'on_delete=CASCADE']
  permission_id integer [not null, ref: > auth_permission.id, note: 'on_delete=CASCADE']

  indexes {
    user_id [note: 'implicit: Django indexes every ForeignKey column']
    permission_id [note: 'implicit: Django indexes every ForeignKey column']
    (user_id, permission_id) [unique]
  }
}

// ==========================================================================
// app: contenttypes
// ==========================================================================

Table django_content_type {
  id        integer      [pk]
  app_label varchar(100) [not null]
  model     varchar(100) [not null]

  indexes {
    (app_label, model) [unique]
  }
}

// ==========================================================================
// app: sessions
// ==========================================================================

Table django_session {
  session_key  varchar(40) [pk]
  session_data text        [not null]
  expire_date  timestamptz [not null]

  indexes {
    expire_date
  }

  Note: 'Django provides full support for anonymous sessions.'
}

